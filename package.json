{
  "name": "roomly",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/check-build-env.mjs && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:db": "supabase test db --local",
    "test:embeds": "node scripts/check-embeds.mjs",
    "check:responsive": "node scripts/check-responsive.mjs",
    "build:icons": "node scripts/build-icons.mjs",
    "jobs:run": "node scripts/run-jobs.mjs",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "@mercadopago/sdk-react": "^1.1.0",
    "@sentry/nextjs": "^11.17.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.2",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.79.0",
    "mercadopago": "^3.6.2",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "^3.11.1",
    "resend": "^6.39.0",
    "tailwind-merge": "^3.7.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.1.1",
    "eslint": "^10",
    "eslint-config-next": "16.4.6",
    "supabase": "^3.3.0",
    "tailwindcss": "^4",
    "typescript": "^7",
    "vitest": "^5.1.1"
  },
  "allowScripts": {
    "@sentry/cli@2.58.6": true,
    "unrs-resolver@1.12.2": true
  }
}
